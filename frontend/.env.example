# URL of the Express backend (the /backend folder). next.config.mjs forwards every /api/* request to it.
BACKEND_URL=http://localhost:5000

# Optional. Leave empty: the Contact Us and Support Us message forms are saved by the backend (/api/messages)
# and appear in Admin -> Messages. Only set this if you want the forms to post to some other service.
NEXT_PUBLIC_CONTACT_ENDPOINT=
